function upd(dt){
let ix=jv.x,iy=jv.y;if(!js){ix=(K.d||K.arrowright?1:0)-(K.a||K.arrowleft?1:0);iy=(K.s||K.arrowdown?1:0)-(K.w||K.arrowup?1:0);const l=Math.hypot(ix,iy);if(l>1){ix/=l;iy/=l}}

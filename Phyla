const P={x:WS/2,y:WS/2,vx:0,vy:0,fs:1,ft:1,tl:0,sw:0,sp:0,et:9,r:16,hp:100,dna:0,tot:0,ph:1,spc:0,fl:0,pi:0,te:0,ca:0,an:0,al:0,bi:0,sk:0,pat:0,inv:0,fx:0};

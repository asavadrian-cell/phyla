const mkFood=f=>{f.x=rnd(40,WS-40);f.y=rnd(40,WS-40);f.r=rnd(3,5.5);f.h=rnd(30,190);f.ty=Math.floor(rnd(0,3));return f};
const mkFoe=f=>{const tb=FT[P.ph>1?2:1],ks=Object.keys(tb);let q=Math.random(),k=ks[ks.length-1];for(const n of ks){q-=tb[n].wt;if(q<=0){k=n;break}}const Q=tb[k];f.k=k;f.x=rnd(100,WS-100);f.y=rnd(100,WS-100);if(Math.hypot(f.x-P.x,f.y-P.y)<450)f.x=(f.x+700)%WS;f.r=rnd(Q.r[0],Q.r[1]);f.hp=f.r*2;f.a=rnd(0,6.28);f.h=f.a;f.t=rnd(0,9);f.sw=rnd(0,9);f.sd=rnd(0,9);f.fs=1;f.tl=0;f.sp=.5;

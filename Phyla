{n:'Cristalino',d:'Equilibrado, con aletas de hoja translúcidas. +Velocidad leve',L:2.1,H:.5,ext:[3.6,2.3],b:{spd:.3,dmg:0,def:0},c:['#a8d6dc','#4f8f9e','#e6f3ee']},
{n:'Espinoso',d:'Dorso erizado de espinas curvas. +Daño',L:2.0,H:.56,ext:[3.5,2.2],b:{spd:0,dmg:1,def:0},c:['#a9c6d0','#58808f','#f2d9a8']},

for(let i=0;i<26;i++)BB.push({x:Math.random(),y:Math.random(),r:rnd(4,16),s:rnd(.01,.035),p:rnd(0,6)});
let js=null,jv={x:0,y:0},open=false,won=false,T=0,tab='p';const K={};
cv.addEventListener('pointerdown',e=>{if(!open)js={ox:e.clientX,oy:e.clientY,x:e.clientX,y:e.clientY}});

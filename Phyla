ame:{w:.45,c:1.05,fl:.9,cr:210,fr:240,tw:.01,tn:1,dna:12,r:[28,42],wt:.24},
rad:{w:.25,c:0,fl:0,cr:0,fr:0,tw:.004,tn:1,dna:10,r:[20,30],wt:.2},
bac:{w:1.5,c:0,fl:2.4,cr:0,fr:280,tw:.05,tn:1.3,dna:4,r:[11,17],wt:.22}},
2:{
